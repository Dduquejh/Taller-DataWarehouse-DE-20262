# Variables que necesita docker/docker-compose.aws.yml. En EC2 no se escribe a
# mano: dw-render-env genera .env desde el parámetro de SSM
# /<proyecto>/pipeline/env (creado por Terraform) más los secretos locales
# de Airflow (.airflow-secrets). Ningún valor de aquí es una contraseña de
# base de datos: el código las lee de Secrets Manager con el rol de la instancia.

# ---- AWS (parámetro de SSM)
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET=ecommerce-dw-123456789012
S3_RAW_PREFIX=raw
S3_CONTROL_PREFIX=control
TLS_CA_FILE=/opt/airflow/certs/global-bundle.pem

MYSQL_HOST=ecommerce-dw-mysql.xxxxxxxx.us-east-2.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce
MYSQL_SECRET_ARN=arn:aws:secretsmanager:us-east-2:123456789012:secret:rds!db-xxxx

DOCDB_HOST=ecommerce-dw-docdb.cluster-xxxxxxxx.us-east-2.docdb.amazonaws.com
DOCDB_PORT=27017
MONGO_DATABASE=ecommerce
DOCDB_SECRET_ARN=arn:aws:secretsmanager:us-east-2:123456789012:secret:rds!cluster-xxxx

REDSHIFT_HOST=ecommerce-dw.123456789012.us-east-2.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=ecommerce_dw
REDSHIFT_WORKGROUP=ecommerce-dw
REDSHIFT_SECRET_ARN=arn:aws:secretsmanager:us-east-2:123456789012:secret:redshift!ecommerce-dw-admin-xxxx
REDSHIFT_COPY_ROLE_ARN=arn:aws:iam::123456789012:role/ecommerce-dw-redshift-s3

# Opcional: datasets SPICE de QuickSight que se refrescan al terminar un lote.
# QUICKSIGHT_DATASET_IDS=dataset-id-1,dataset-id-2

# ---- Airflow (.airflow-secrets, generados en la instancia)
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=<generado>
AIRFLOW_SECRET_KEY=<generado>
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=<generado>
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<generado>
